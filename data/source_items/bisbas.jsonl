{"id": "bisbas_01", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 1, "subscale": "filler", "component_class": "none", "maps_to": null, "text": "A person's family is the most important thing in life.", "reverse_keyed": true, "negated_for_balance": false, "is_filler": true, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
{"id": "bisbas_02", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 2, "subscale": "bis", "component_class": "adaptive", "maps_to": "behavioral_inhibition_social_risk", "text": "Even if something bad is about to happen to me, I rarely experience fear or nervousness.", "reverse_keyed": false, "negated_for_balance": false, "is_filler": false, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
{"id": "bisbas_03", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 3, "subscale": "bas_drive", "component_class": "conditional", "maps_to": "dark_approach_motivation", "text": "I go out of my way to get things I want.", "reverse_keyed": true, "negated_for_balance": false, "is_filler": false, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
{"id": "bisbas_04", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 4, "subscale": "bas_reward_responsiveness", "component_class": "conditional", "maps_to": "anhedonia_reversed", "text": "When I'm doing well at something I love to keep at it.", "reverse_keyed": true, "negated_for_balance": false, "is_filler": false, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
{"id": "bisbas_05", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 5, "subscale": "bas_fun_seeking", "component_class": "pathological", "maps_to": "disinhibition", "text": "I'm always willing to try something new if I think it will be fun.", "reverse_keyed": true, "negated_for_balance": false, "is_filler": false, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
{"id": "bisbas_06", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 6, "subscale": "filler", "component_class": "none", "maps_to": null, "text": "How I dress is important to me.", "reverse_keyed": true, "negated_for_balance": false, "is_filler": true, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
{"id": "bisbas_07", "mechanism": "motivational_systems", "instrument": "BIS/BAS", "item_no": 7, "subscale": "bas_reward_responsiveness", "component_class": "conditional", "maps_to": "anhedonia_reversed", "text": "When I get something I want, I feel excited and energized.", "reverse_keyed": true, "negated_for_balance": false, "is_filler": false, "scale": "1-4 (1 = very true for me .. 4 = very false for me)", "content_risk": "none"}
