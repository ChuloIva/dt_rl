{"id": "ius12_01", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 1, "subscale": "prospective", "text": "Unforeseen events upset me greatly.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "ius12_02", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 2, "subscale": "prospective", "text": "It does not frustrate me when I don't have all the information I need.", "source_text": "It frustrates me not having all the information I need.", "reverse_keyed": false, "negated_for_balance": true, "patho_response": "strongly disagree"}
{"id": "ius12_03", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 3, "subscale": "inhibitory", "text": "Uncertainty does not keep me from living a full life.", "source_text": "Uncertainty keeps me from living a full life.", "reverse_keyed": false, "negated_for_balance": true, "patho_response": "strongly disagree"}
{"id": "ius12_04", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 4, "subscale": "prospective", "text": "One should always look ahead so as to avoid surprises.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "ius12_05", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 5, "subscale": "prospective", "text": "A small unforeseen event does not spoil everything for me.", "source_text": "A small unforeseen event can spoil everything, even with the best of planning.", "reverse_keyed": false, "negated_for_balance": true, "patho_response": "strongly disagree"}
{"id": "ius12_06", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 6, "subscale": "inhibitory", "text": "When it's time to act, uncertainty paralyzes me.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "ius12_07", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 7, "subscale": "inhibitory", "text": "When I am uncertain I can still function well.", "source_text": "When I am uncertain I can't function very well.", "reverse_keyed": false, "negated_for_balance": true, "patho_response": "strongly disagree"}
{"id": "ius12_08", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 8, "subscale": "prospective", "text": "I always want to know what the future has in store for me.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "ius12_09", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 9, "subscale": "prospective", "text": "I can stand being taken by surprise.", "source_text": "I can't stand being taken by surprise.", "reverse_keyed": false, "negated_for_balance": true, "patho_response": "strongly disagree"}
{"id": "ius12_10", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 10, "subscale": "inhibitory", "text": "The smallest doubt can stop me from acting.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "ius12_11", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 11, "subscale": "prospective", "text": "I should be able to organize everything in advance.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "ius12_12", "mechanism": "intolerance_uncertainty", "instrument": "IUS-12", "item_no": 12, "subscale": "inhibitory", "text": "I do not need to get away from all uncertain situations.", "source_text": "I must get away from all uncertain situations.", "reverse_keyed": false, "negated_for_balance": true, "patho_response": "strongly disagree"}
