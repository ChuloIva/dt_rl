{"id": "pswq_07", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 7, "text": "I am always worrying about something.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
{"id": "pswq_08", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 8, "text": "I find it easy to dismiss worrisome thoughts.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree"}
