{"id": "pswq_10", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 10, "text": "I never worry about anything.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree"}
{"id": "pswq_11", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 11, "text": "When there is nothing more I can do about a concern, I do not worry about it any more.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree"}
