{"id": "pswq_01", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 1, "text": "If I do not have enough time to do everything, I do not worry about it.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree"}
