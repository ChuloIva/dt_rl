{"id": "pswq_03", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 3, "text": "I do not tend to worry about things.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree"}
{"id": "pswq_04", "mechanism": "worry", "instrument": "PSWQ-16", "item_no": 4, "text": "Many situations make me worry.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree"}
