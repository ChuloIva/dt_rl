{"id": "nss_orig_01", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 1, "text": "Deep down, I am inadequate.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree", "original_item": true}
{"id": "nss_orig_02", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 2, "text": "If people really knew me, they would reject me.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree", "original_item": true}
{"id": "nss_orig_03", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 3, "text": "I am fundamentally more flawed than other people.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree", "original_item": true}
{"id": "nss_orig_04", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 4, "text": "My worth as a person depends on succeeding at everything I do.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree", "original_item": true}
{"id": "nss_orig_05", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 5, "text": "One serious mistake is enough to show that I am a failure.", "reverse_keyed": false, "negated_for_balance": false, "patho_response": "strongly agree", "original_item": true}
{"id": "nss_orig_06", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 6, "text": "I am a worthwhile person even when I fail at something.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree", "original_item": true}
{"id": "nss_orig_07", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 7, "text": "I deserve care and respect just like anyone else.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree", "original_item": true}
{"id": "nss_orig_08", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 8, "text": "Making mistakes does not make me less of a person.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree", "original_item": true}
{"id": "nss_orig_09", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 9, "text": "People generally like me once they get to know me.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree", "original_item": true}
{"id": "nss_orig_10", "mechanism": "negative_self_schema", "instrument": "NSS-orig", "item_no": 10, "text": "I can handle difficult situations as well as most people.", "reverse_keyed": true, "negated_for_balance": false, "patho_response": "strongly disagree", "original_item": true}
